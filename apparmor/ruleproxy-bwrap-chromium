# Adapted from Ubuntu apparmor-profiles 4.0.1really4.0.1-0ubuntu0.24.04.8
# bwrap-userns-restrict (GPL-2+); see ../licenses/APPARMOR-GPL-2.txt.
# Dedicated Chromium bwrap copy. CAP_SYS_ADMIN and CAP_SYS_CHROOT are allowed
# only in its child profile so Chromium can create its nested user-namespace
# sandbox and chroot renderer processes. Chromium drops capabilities after
# chroot. The outer bwrap namespace already exists before this profile runs.

abi <abi/4.0>,

include <tunables/global>

profile bwrap_chromium /usr/local/lib/ruleproxy-web/bwrap-chromium flags=(attach_disconnected) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow px /** -> bwrap_chromium//&unpriv_bwrap_chromium,
}

profile unpriv_bwrap_chromium flags=(attach_disconnected) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow capability sys_admin,
  allow capability sys_chroot,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &unpriv_bwrap_chromium,
}
