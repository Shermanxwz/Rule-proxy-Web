+  if(!handle)return GetLastError()?GetLastError():ERROR_NOT_ENOUGH_MEMORY;
+  if(!impl_->thread.take(reinterpret_cast<HANDLE>(handle)))return ERROR_INVALID_HANDLE;
+  if(!SetHandleInformation(impl_->thread.value,HANDLE_FLAG_INHERIT,0))return GetLastError();
+  while(!c.entered.load()&&!c.done.load()&&timeout_ms(p.frequency,p.capture_cutoff))Sleep(1);
