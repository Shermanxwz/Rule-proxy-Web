diff --git a/tests/test_windows_dns_etw_native.py b/tests/test_windows_dns_etw_native.py
new file mode 100644
--- /dev/null
+++ b/tests/test_windows_dns_etw_native.py
@@ -0,0 +1,33 @@
+"""Compiles/runs portable fake only; never imports/calls ETW backend."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+class NativeEtwCoreTests(unittest.TestCase):
+    def test_portable_resource_filter_ownership_recovery_failures(self):
+        compiler = shutil.which("cl.exe") if os.name == "nt" else shutil.which("c++")
+        self.assertIsNotNone(compiler, "use the installed x64 developer compiler shell")
+        with tempfile.TemporaryDirectory() as directory:
+            out = Path(directory)
+            exe = out / ("etw-core-fake.exe" if os.name == "nt" else "etw-core-fake")
+            source = ROOT / "tests/native/windows_dns_etw_core_fake.cpp"
+            include = ROOT / ".github/native"
+            if os.name == "nt":
+                argv = [compiler, "/nologo", "/W4", "/WX", "/std:c++17", "/EHsc", "/MT", "/O2",
+                        "/I" + str(include), "/Fo" + str(out / "fake.obj"), "/Fe" + str(exe), str(source)]
+            else:
+                argv = [compiler, "-std=c++17", "-Wall", "-Wextra", "-Werror", "-O2",
+                        "-I", str(include), str(source), "-o", str(exe)]
+            built = subprocess.run(argv, cwd=out, capture_output=True, text=True, timeout=60)
+            self.assertEqual(built.returncode, 0, built.stdout + built.stderr)
+            run = subprocess.run([str(exe)], cwd=out, capture_output=True, text=True, timeout=30)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertRegex(run.stdout, r"ETW_FAKE_SCENARIOS [1-9][0-9]{3,}")
+            self.assertNotIn("FAIL ", run.stdout)
+            print(run.stdout.strip())
+if __name__ == "__main__":
+    unittest.main()
