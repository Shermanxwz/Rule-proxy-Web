+    PROCESS_TRACE_MODE_EVENT_RECORD|PROCESS_TRACE_MODE_REAL_TIME|PROCESS_TRACE_MODE_RAW_TIMESTAMP;
+  c.logfile.Context=&c;c.logfile.EventRecordCallback=on_event;c.logfile.BufferCallback=on_buffer;
+  c.trace=OpenTraceW(&c.logfile);if(c.trace==INVALID_PROCESSTRACE_HANDLE)return GetLastError();
