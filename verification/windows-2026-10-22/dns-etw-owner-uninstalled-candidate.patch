+}
+bool WindowsBackend::release_filters_and_thread()noexcept{
+ bool ok=true;
+ if(impl_->aggregate_owned&&!impl_->aggregate_consumed){impl_->aggregate_consumed=true;impl_->aggregate_owned=false;
+  EVENT_FILTER_DESCRIPTOR owned=impl_->aggregate;impl_->aggregate={};
+  if(TdhCleanupPayloadEventFilterDescriptor(&owned)!=ERROR_SUCCESS)ok=false;}
+ for(unsigned i=0;i<5;++i)if(impl_->filters[i]&&!impl_->filter_consumed[i]){
+  auto owned=impl_->filters[i];impl_->filters[i]=nullptr;impl_->filter_consumed[i]=true;
+  if(TdhDeletePayloadFilter(&owned)!=ERROR_SUCCESS)ok=false;}
+ if(impl_->consumer){
+  if(!impl_->thread_exited&&impl_->thread.value){impl_->retained=true;ok=false;}
+  else{
+   ok=impl_->consumer->controller.close()&&ok;ok=impl_->consumer->ordinary.close()&&ok;
+  }
+ }
+ if(impl_->thread.value){if(impl_->thread_exited){impl_->thread_close_confirmed=impl_->thread.close();ok=impl_->thread_close_confirmed&&ok;}
+  else ok=false;}
+ ok=impl_->controller.close()&&ok;ok=impl_->ordinary.close()&&ok;
+ impl_->opaque_clean=impl_->opaque_clean&&ok;return impl_->opaque_clean;
+}
+EventCounters WindowsBackend::counters()const noexcept{
+ if(!impl_->consumer)return EventCounters{};try{std::lock_guard<std::mutex> g(impl_->consumer->lock);return impl_->consumer->facts;}
+ catch(...){EventCounters failed;failed.callback_failed=true;return failed;}
+}
