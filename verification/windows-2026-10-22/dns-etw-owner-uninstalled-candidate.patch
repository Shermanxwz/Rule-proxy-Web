+ const auto timeout=timeout_ms(p.frequency,p.final_cutoff);if(!timeout)return ERROR_TIMEOUT;
+ return EnableTraceEx2(id,&Provider,EVENT_CONTROL_CODE_DISABLE_PROVIDER,0,0,0,timeout,nullptr);
