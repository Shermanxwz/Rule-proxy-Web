+inline bool valid(const Plan& p){
+    if(!p.frequency||p.frequency>1000000000ULL||!p.start||p.deadline>0x7fffffffffffffffULL||p.start>=p.capture_cutoff||
+        p.capture_cutoff>=p.stop_cutoff||p.stop_cutoff>=p.drain_cutoff||
