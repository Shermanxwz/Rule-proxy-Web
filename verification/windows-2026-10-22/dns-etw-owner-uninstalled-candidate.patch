+std::uint32_t WindowsBackend::stop(const Plan& p,std::uint64_t id)noexcept{
+ auto storage=properties(p);const auto status=ControlTraceW(id,SessionName,&storage.props,EVENT_TRACE_CONTROL_STOP);
+ impl_->statistics.known=status==ERROR_SUCCESS;
