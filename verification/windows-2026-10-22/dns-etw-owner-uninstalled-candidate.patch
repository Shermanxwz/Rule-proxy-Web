+bool WindowsBackend::consumer_running()const noexcept{return impl_->consumer&&impl_->thread.value&&impl_->consumer->entered.load()&&
+ !impl_->consumer->done.load()&&!impl_->consumer->binding_failed.load()&&WaitForSingleObject(impl_->thread.value,0)==WAIT_TIMEOUT;}
