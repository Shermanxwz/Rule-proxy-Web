+std::uint32_t WindowsBackend::query(const Plan& p,std::uint64_t id,Snapshot& out)noexcept{
+ try{auto storage=properties(p);const auto status=ControlTraceW(id,SessionName,&storage.props,EVENT_TRACE_CONTROL_QUERY);
+  if(status!=ERROR_SUCCESS)return status;out=Snapshot{};
