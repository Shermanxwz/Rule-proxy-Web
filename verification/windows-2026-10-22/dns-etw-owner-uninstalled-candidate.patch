@@ -0,0 +1,183 @@
+"""Closed ordinary ETW mechanism contracts. Importing never calls Windows APIs.
+
+This first profile has three ordinary controls, not a selected-application cell.
+The JSON remains a private commitment; RDP1 contains fixed native fields only.
+"""
+from __future__ import annotations
+import hashlib
+import json
+from pathlib import PurePosixPath
+import struct
+import uuid
+
+PROFILE='ordinary-standard53-dns-client-etw-mechanism-v1'
+SCOPE='one-ordinary-standard53-dns-client-etw-mechanism-v1'
+RECOVERY_SCOPE='one-exact-owned-dns-client-etw-recovery-v1'
+SESSION='RuleProxy.Web.DnsClientAttribution'
+PROVIDER='1c95126e-7eea-49a9-a3fe-a378b03ddb4d'
+METADATA='7a07780a049b35948e5ecabd4a2d49dcb88dd586d47ea6ab29aca29c7d553f3c'
+DNSAPI='c7e1006f7bcbdff6d3668d10b9756a9734c53ccc47783f8908f68b60d0341bbb'
+CASES=('before','probe','after')
+LIMITS=dict(buffer_kib=16,minimum_buffers=4,maximum_buffers=16,maximum_memory_bytes=1048576,
+    maximum_records=256,maximum_user_data_bytes=4096,maximum_store_bytes=262144,flush_seconds=1)
+PRIVACY=dict(event_ids=[3010,3011],versions=[[3010,0],[3010,1],[3011,0],[3011,1],[3011,2]],
+    terminal_dot=True,raw_payload=False,raw_pids=False,stack=False,unfiltered_fallback=False)
+PATHS=dict(control='etw-control',reports='etw-reports',journal='etw-journal')
+QPC_KEYS={'frequency','start','root_deadline','capture_cutoff','stop_cutoff','drain_cutoff','final_cutoff'}
+MAX_CONFIG=16384
+MAX_JOURNAL=65536
+MAX_RECORDS=64
+MAX_SIGNED=0x7fffffffffffffff
+KINDS=('initial','launch-intent','launch-returned','owner-admitted','start-intent','start-returned',
+    'snapshot-returned','stop-intent','stop-returned','owner-exit','owner-close','final',
+    'recovery-verified','recovery-stop-intent','recovery-stop-returned','recovery-final')
+DATA_KEYS={
+    'initial':{'binary_sha256'},'launch-intent':{'spawn_unknown'},'launch-returned':{'pid','creation_time'},
+    'owner-admitted':{'pid','creation_time','identity_sha256'},'start-intent':{'command_sha256'},
+    'start-returned':{'reply_sha256','ready'},'snapshot-returned':{'reply_sha256','case_role'},
+    'stop-intent':{'command_sha256'},'stop-returned':{'reply_sha256','cleanup_verified','historical_uncertain'},
+    'owner-exit':{'exited','exit_code'},'owner-close':{'closed'},
+    'final':{'cleanup_verified','recovery_required'},
+    'recovery-verified':{'old_journal_sha256','original_owner_exited','original_call_worker_exited'},
+    'recovery-stop-intent':{'fresh_control_verified'},'recovery-stop-returned':{'stop_status','absence_verified'},
+    'recovery-final':{'cleanup_verified','historical_original_uncertainty_preserved'}}
+
+def require(ok,reason='etw_contract'):
+    if not ok:raise ValueError(reason)
+def integer(value,low=0,high=0xffffffff):return type(value) is int and low<=value<=high
+def digest(value):return type(value) is str and len(value)==64 and all(c in '0123456789abcdef' for c in value)
+def nonce(value):return type(value) is str and len(value)==32 and all(c in '0123456789abcdef' for c in value)
+def encode(value):return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True)+'\n').encode('ascii')
+def sha(raw):return hashlib.sha256(raw).hexdigest()
+def decode(raw,limit=MAX_CONFIG):
+    require(type(raw) is bytes and 0<len(raw)<=limit,'etw_json_bound')
+    def pairs(items):
+        out={}
+        for key,value in items:require(key not in out,'etw_duplicate_key');out[key]=value
+        return out
+    return json.loads(raw.decode('utf-8','strict'),object_pairs_hook=pairs)
+def guid(value):
+    require(type(value) is str,'etw_guid')
+    parsed=uuid.UUID(value)
+    require(str(parsed)==value and parsed.version==4 and parsed.variant==uuid.RFC_4122 and value!=PROVIDER,'etw_guid')
+    return parsed
+def job_name(boot):require(nonce(boot),'etw_boot');return 'Local\\RuleProxy.DnsEtwOwner.'+boot
+def clock(value):
+    require(type(value) is dict and set(value)==QPC_KEYS and all(integer(v,1,MAX_SIGNED) for v in value.values()),'etw_clock')
+    f,t,d=value['frequency'],value['start'],value['root_deadline']
+    require(f<=1000000000 and t<d<=t+120*f,'etw_clock_domain')
+    require(t<value['capture_cutoff']<=d-20*f and value['stop_cutoff']==d-12*f
+        and value['drain_cutoff']==d-7*f and value['final_cutoff']==d-5*f,'etw_reserves')
+    return value
+def process(value,controller=False):
+    keys={'pid','session_id','creation_time','image_sha256'} | ({'user_sid','maintenance_job'} if controller else set())
+    require(type(value) is dict and set(value)==keys and integer(value['pid'],1) and integer(value['session_id'])
+        and integer(value['creation_time'],1,MAX_SIGNED) and digest(value['image_sha256']),'etw_process_binding')
+    if controller:require(type(value['user_sid']) is str and value['user_sid'].startswith('S-1-5-') and len(value['user_sid'])<=184,'etw_user')
+    return value
+def config(value,source_names):
+    keys={'schema_version','profile','run_id','boot_case_id','session','qpc','source','controller','clients','cases','limits','paths','privacy'}
+    require(type(value) is dict and set(value)==keys and integer(value['schema_version'],1,1) and value['profile']==PROFILE
+        and nonce(value['run_id']) and nonce(value['boot_case_id']),'etw_config')
+    session=value['session'];require(type(session) is dict and set(session)=={'name','guid'} and session['name']==SESSION,'etw_session')
+    guid(session['guid']);clock(value['qpc']);process(value['controller'],True)
+    require(value['controller']['maintenance_job']==job_name(value['boot_case_id']),'etw_maintenance_job')
+    clients=value['clients'];require(type(clients) is dict and set(clients)=={'ordinary'},'etw_ordinary_only')
+    ordinary=process(clients['ordinary']);controller=value['controller']
+    require(ordinary['pid']!=controller['pid'] and ordinary['session_id']==controller['session_id'],'etw_process_roles')
+    source=value['source'];require(type(source) is dict and set(source)=={'commit','source_hashes','closure_sha256','owner_image_sha256','metadata_sha256','dnsapi_sha256'},'etw_source')
+    require(type(source['commit']) is str and len(source['commit'])==40 and all(c in '0123456789abcdef' for c in source['commit']),'etw_source_commit')
+    hashes=source['source_hashes'];require(type(hashes) is dict and set(hashes)==set(source_names) and 1<=len(hashes)<=64,'etw_source_names')
+    for name,checksum in hashes.items():
+        path=PurePosixPath(name);require(not path.is_absolute() and '..' not in path.parts and str(path)==name and digest(checksum),'etw_source_path')
+    require(digest(source['owner_image_sha256']) and sha(encode(hashes))==source['closure_sha256']
+        and source['metadata_sha256']==METADATA and source['dnsapi_sha256']==DNSAPI,'etw_source_pin')
+    rows=value['cases'];require(type(rows) is dict and set(rows)==set(CASES),'etw_cases')
+    nonces=[value['run_id'],value['boot_case_id']]
+    for role in CASES:
+        row=rows[role];require(type(row) is dict and set(row)=={'case_id','client_role','phase_deadline'} and nonce(row['case_id'])
+            and row['client_role']=='ordinary' and integer(row['phase_deadline'],value['qpc']['start']+1,value['qpc']['capture_cutoff']),'etw_case')
+        nonces.append(row['case_id'])
+    require(len(set(nonces))==5,'etw_nonce_pack')
+    require(value['limits']==LIMITS and all(type(value['limits'][k]) is int for k in LIMITS),'etw_limits')
+    require(encode(value['paths'])==encode(PATHS) and encode(value['privacy'])==encode(PRIVACY),'etw_privacy')
+    require(len(encode(value))<=MAX_CONFIG,'etw_config_bound');return value
+def plan(value,c,*,device_sha256,config_sha256):
+    keys={'schema_version','scope','device_sha256','source_sha256','owner_image_sha256','config_sha256','session_guid',
+        'etw_session_impact_acknowledged','standard53_impact_acknowledged','recovery_reference'}
+    require(type(value) is dict and set(value)==keys and integer(value['schema_version'],1,1) and value['scope']==SCOPE,'etw_plan')
+    for key,expected in (('device_sha256',device_sha256),('source_sha256',c['source']['closure_sha256']),
+            ('owner_image_sha256',c['source']['owner_image_sha256']),('config_sha256',config_sha256)):
+        require(digest(value[key]) and value[key]==expected,'etw_plan_binding')
+    require(value['session_guid']==c['session']['guid'] and value['etw_session_impact_acknowledged'] is True
+        and value['standard53_impact_acknowledged'] is True and type(value['recovery_reference']) is str
+        and 1<=len(value['recovery_reference'])<=512,'etw_plan_admission');return value
+
+def binary_plan(c,config_sha256):
+    require(digest(config_sha256),'etw_binary_config_sha');raw=bytearray(512);raw[:8]=b'RDP1\x01\x01\x03\x00'
+    q=c['qpc'];struct.pack_into('<7Q',raw,8,*(q[k] for k in ('frequency','start','root_deadline','capture_cutoff','stop_cutoff','drain_cutoff','final_cutoff')))
+    raw[64:80]=guid(c['session']['guid']).bytes_le;raw[80:96]=bytes.fromhex(c['run_id']);raw[96:112]=bytes.fromhex(c['boot_case_id'])
+    for offset,value in ((112,config_sha256),(144,c['source']['closure_sha256']),(176,c['source']['owner_image_sha256']),
+            (208,METADATA),(304,DNSAPI),(352,c['controller']['image_sha256'])):raw[offset:offset+32]=bytes.fromhex(value)
+    for offset,role in zip((240,256,272),CASES):raw[offset:offset+16]=bytes.fromhex(c['cases'][role]['case_id'])
+    p=c['clients']['ordinary'];struct.pack_into('<IIQ',raw,288,p['pid'],p['session_id'],p['creation_time'])
+    p=c['controller'];struct.pack_into('<IIQ',raw,336,p['pid'],p['session_id'],p['creation_time'])
+    return bytes(raw)
+def validate_binary(raw,c,config_sha256):
+    require(type(raw) is bytes and len(raw)==512 and raw==binary_plan(c,config_sha256),'etw_binary_binding');return raw
+def command(c,config_sha256,sequence,opcode):
+    require(digest(config_sha256) and integer(sequence,1,8) and type(opcode) is int and opcode in (1,2,255)
+        and (sequence==1)==(opcode==1),'etw_command')
+    raw=bytearray(128);raw[:6]=b'RDE1\x01'+bytes([opcode]);struct.pack_into('<I',raw,8,sequence)
+    raw[16:32]=bytes.fromhex(c['run_id']);raw[32:48]=bytes.fromhex(c['boot_case_id'])
+    struct.pack_into('<QQ',raw,48,c['qpc']['frequency'],c['qpc']['root_deadline']);raw[64:80]=guid(c['session']['guid']).bytes_le
+    raw[80:112]=bytes.fromhex(config_sha256);struct.pack_into('<Q',raw,112,c['qpc']['stop_cutoff' if opcode==255 else 'capture_cutoff'])
+    return bytes(raw)
+def validate_command(raw,c,config_sha256,sequence,opcode):
+    require(type(raw) is bytes and raw==command(c,config_sha256,sequence,opcode),'etw_command_binding');return raw
+
+def ready(value,c,config_sha256,held):
+    keys={'schema_version','stage','run_id','boot_case_id','config_sha256','owner_pid','identity','qpc','metadata_verified','session_started','provider_enabled','ready','failure'}
+    require(type(value) is dict and set(value)==keys and integer(value['schema_version'],1,1) and value['stage']=='dns-etw-owner-ready'
+        and value['run_id']==c['run_id'] and value['boot_case_id']==c['boot_case_id'] and value['config_sha256']==config_sha256
+        and type(value['owner_pid']) is int and value['owner_pid']==held['pid'] and value['identity']==held['identity'],'etw_ready_binding')
+    q=value['qpc'];require(type(q) is list and len(q)==4 and all(integer(v,1,MAX_SIGNED) for v in q)
+        and q[:3]==[c['qpc']['frequency'],c['qpc']['start'],c['qpc']['root_deadline']] and q[1]<=q[3]<c['qpc']['capture_cutoff'],'etw_ready_clock')
+    require(value['metadata_verified'] is True and value['ready'] is True and value['failure'] is None
+        and value['session_started'] is False and value['provider_enabled'] is False,'etw_ready_no_trace');return value
+
+def journal_record(sequence,kind,c,config_sha256,previous_sha256,data):
+    require(integer(sequence,1,MAX_RECORDS) and kind in KINDS and digest(config_sha256) and
+        (previous_sha256 is None if sequence==1 else digest(previous_sha256)),'etw_journal_record')
+    require(type(data) is dict and set(data)==DATA_KEYS[kind] and len(encode(data))<=4096,'etw_journal_data_bound')
+    for key,item in data.items():
+        if key.endswith('sha256'):require(digest(item),'etw_journal_digest')
+        elif key=='case_role':require(item in CASES,'etw_journal_case')
+        elif key in ('pid','creation_time'):require(integer(item,1,MAX_SIGNED),'etw_journal_integer')
+        elif key in ('exit_code','stop_status'):require(item is None or integer(item),'etw_journal_status')
+        else:require(type(item) is bool,'etw_journal_bool')
+    return dict(schema_version=1,stage='dns-etw-owner-journal',sequence=sequence,kind=kind,
