+        if lock is not None:
+            try:closing=lock;lock=None;api.release_component_lock(closing)
+            except (ValueError,OSError,local.RuntimeUnavailable):out.update(completed=False,recovery_required=True)
+        if journal is not None:
+            try:journal.append('recovery-final',dict(cleanup_verified=out['completed'],historical_original_uncertainty_preserved=True))
+            except (ValueError,OSError):out.update(completed=False,recovery_required=True)
+    return out
