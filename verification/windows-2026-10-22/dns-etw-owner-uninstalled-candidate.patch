+  if(!bounded_string(storage,storage.props.LoggerNameOffset,out.name))return ERROR_INVALID_DATA;
+  std::wstring logfile;if(!bounded_string(storage,storage.props.LogFileNameOffset,logfile))return ERROR_INVALID_DATA;
+  out.has_log_file=!logfile.empty();out.mode=storage.props.LogFileMode;out.clock=storage.props.Wnode.ClientContext;
+  out.buffer_kib=storage.props.BufferSize;out.minimum=storage.props.MinimumBuffers;out.maximum=storage.props.MaximumBuffers;
+  out.enable_flags=storage.props.EnableFlags;out.events_lost=storage.props.EventsLost;
