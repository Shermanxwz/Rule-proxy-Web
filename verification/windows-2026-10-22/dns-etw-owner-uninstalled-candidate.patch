+std::uint32_t WindowsBackend::close_consumer()noexcept{
+ if(!impl_->consumer||!impl_->consumer->trace_owned||impl_->consumer->trace_consumed)return ERROR_INVALID_HANDLE;
+ auto& c=*impl_->consumer;const auto owned=c.trace;c.trace_owned=false;c.trace_consumed=true;c.trace=INVALID_PROCESSTRACE_HANDLE;
+ return CloseTrace(owned);
+}
+bool WindowsBackend::drain(const Plan& p,std::uint64_t deadline)noexcept{
+ if(!impl_->consumer)return true;if(!impl_->thread.value){impl_->thread_exited=!impl_->consumer->entered.load();return impl_->thread_exited;}
+ for(;;){
+  const auto status=WaitForSingleObject(impl_->thread.value,0);
+  if(status==WAIT_OBJECT_0){impl_->thread_exited=true;return impl_->consumer->done.load();}
+  if(status!=WAIT_TIMEOUT)return false;const auto left=timeout_ms(p.frequency,deadline);if(!left)return false;
+  Sleep(std::min<std::uint32_t>(left,10));
