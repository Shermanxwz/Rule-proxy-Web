+ id=0;try{if(!impl_->trusted()||!impl_->filters_built||!impl_->bindings()||!timeout_ms(p.frequency,p.capture_cutoff))return ERROR_INVALID_STATE;
+  auto storage=properties(p);CONTROLTRACE_ID trace{};const auto status=StartTraceW(&trace,SessionName,&storage.props);
+  id=trace;return status;
