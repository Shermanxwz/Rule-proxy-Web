+inline bool decode_plan(const std::uint8_t* b,std::size_t n,Plan& p){
+    if(!b||n!=512||std::memcmp(b,"RDP1",4)||b[4]!=1||b[5]!=1||b[6]!=3||b[7])return false;
+    for(unsigned i=384;i<512;++i)if(b[i])return false;
+    p=Plan{};p.frequency=le(b+8,8);p.start=le(b+16,8);p.deadline=le(b+24,8);
+    p.capture_cutoff=le(b+32,8);p.stop_cutoff=le(b+40,8);p.drain_cutoff=le(b+48,8);p.final_cutoff=le(b+56,8);
+    std::memcpy(p.session.data(),b+64,16);std::memcpy(p.run.data(),b+80,16);std::memcpy(p.boot.data(),b+96,16);
+    std::memcpy(p.config.data(),b+112,32);std::memcpy(p.source.data(),b+144,32);
+    std::memcpy(p.artifact.data(),b+176,32);std::memcpy(p.metadata.data(),b+208,32);
+    for(unsigned i=0;i<3;++i)std::memcpy(p.cases[i].data(),b+240+16*i,16);
+    p.ordinary_pid=std::uint32_t(le(b+288,4));p.ordinary_session=std::uint32_t(le(b+292,4));
+    p.ordinary_creation=le(b+296,8);std::memcpy(p.dnsapi.data(),b+304,32);
+    p.controller_pid=std::uint32_t(le(b+336,4));p.controller_session=std::uint32_t(le(b+340,4));
+    p.controller_creation=le(b+344,8);std::memcpy(p.controller_image.data(),b+352,32);
+    return valid(p);
+}
+inline std::wstring query_name(const Id& item,bool terminal_dot=false){
+    constexpr wchar_t h[]=L"0123456789abcdef";std::wstring s;s.reserve(45);
+    for(auto b:item){s.push_back(h[b>>4]);s.push_back(h[b&15]);}
+    s+=L".n0a.invalid";if(terminal_dot)s.push_back(L'.');return s;
+}
+inline int match_query(const Plan& p,const std::wstring& name){
+    if(name.size()!=44&&name.size()!=45)return -1;
+    std::wstring normalized;normalized.reserve(name.size());
+    for(wchar_t c:name){if(c>127||c==0)return -1;normalized.push_back(c>=L'A'&&c<=L'Z'?wchar_t(c+32):c);}
+    if(normalized.size()==45){if(normalized.back()!=L'.')return -1;normalized.pop_back();}
+    for(unsigned i=0;i<3;++i)if(normalized==query_name(p.cases[i]))return static_cast<int>(i);return -1;
+}
+struct Command{std::uint8_t operation=0;std::uint32_t sequence=0;std::uint64_t cutoff=0;};
+inline bool decode_command(const std::uint8_t* b,std::size_t n,const Plan& p,std::uint32_t next,std::uint64_t now,Command& out){
+    if(!valid(p)||!b||n!=128||std::memcmp(b,"RDE1",4)||b[4]!=1||b[6]||b[7]||
+        next<1||next>8||le(b+8,4)!=next||le(b+12,4)||le(b+120,8))return false;
+    const auto op=b[5];if(op!=1&&op!=2&&op!=255)return false;
+    const auto cutoff=op==255?p.stop_cutoff:p.capture_cutoff;
+    if(now<p.start||now>=cutoff||le(b+48,8)!=p.frequency||le(b+56,8)!=p.deadline||le(b+112,8)!=cutoff||
+        std::memcmp(b+16,p.run.data(),16)||std::memcmp(b+32,p.boot.data(),16)||
+        std::memcmp(b+64,p.session.data(),16)||std::memcmp(b+80,p.config.data(),32))return false;
+    out={op,next,cutoff};return true;
+}
+struct Descriptor{std::uint16_t id;std::uint8_t version;};
+constexpr std::array<Descriptor,5> Descriptors{{{3010,0},{3010,1},{3011,0},{3011,1},{3011,2}}};
+struct Snapshot{
+    Id guid{};std::uint64_t control=0;
+    std::wstring name;
+    std::uint32_t mode=0,clock=0,buffer_kib=0,minimum=0,maximum=0,enable_flags=0;
+    bool has_log_file=false;
+    std::uint32_t events_lost=0,realtime_lost=0,log_lost=0;
+};
+inline bool same_session(const Plan& p,const Snapshot& s){
+    return s.guid==p.session&&s.name==SessionName&&s.control;
+}
+inline bool exact(const Plan& p,const Snapshot& s){
+    return same_session(p,s)&&s.mode==ExpectedMode&&s.clock==1&&
+        s.buffer_kib&&s.buffer_kib<=64&&s.minimum>=2&&s.maximum>=s.minimum&&
+        std::uint64_t(s.buffer_kib)*s.maximum*1024<=MaxMemory&&!s.enable_flags&&!s.has_log_file;
+}
+enum class Transition:std::uint8_t{Prepared=1,StartIntent,StartReturned,Readback,ConsumerIntent,ConsumerReturned,
+    EnableIntent,EnableReturned,DisableIntent,DisableReturned,StopIntent,StopReturned,Absence,
+    ConsumerCloseIntent,ConsumerCloseReturned,Drained,Freed,RecoveryAdmitted};
+enum class Failure:std::uint8_t{None,Configuration,Clock,Deadline,Journal,Collision,Filters,Start,Readback,
+    Consumer,Enable,Disable,Stop,Absence,Close,Drain,Free,Recovery};
+struct Facts{
+    Failure failure=Failure::None;std::uint32_t status=0;
+    bool prepared=false,filters_built=false,start_intent=false,start_attempted=false,start_returned=false;
+    bool session_owned=false,session_identity_verified=false,consumer_attempted=false,consumer_opened=false;
+    bool enable_intent=false,enable_attempted=false,enable_returned=false,provider_enabled=false,ready=false;
+    bool disable_attempted=false,disable_returned=false,stop_attempted=false,stop_returned=false;
+    bool control_consumed=false,absence_verified=false,consumer_close_attempted=false,consumer_close_confirmed=false;
+    bool drained=false,filters_freed=false,journal_ok=true,historical_uncertain=false,cleanup_verified=false,recovery_required=false,cleanup_attempted=false;
+    std::uint64_t control=0,last_qpc=0;
+    std::uint32_t start_status=0,enable_status=0,disable_status=0,stop_status=0,close_status=0;
+};
+inline void fail(Facts& f,Failure why,std::uint32_t status=InvalidData){
+    if(f.failure==Failure::None){f.failure=why;f.status=status;}f.ready=false;
+}
+template<class API>bool time(API& api,const Plan& p,Facts& f,std::uint64_t cutoff){
+    std::uint64_t now=0;
+    if(!api.now(now)||now<f.last_qpc||now<p.start){fail(f,Failure::Clock);return false;}
+    f.last_qpc=now;if(now>=cutoff){fail(f,Failure::Deadline,DeadlineError);return false;}return true;
+}
+template<class API>bool note(API& api,const Plan& p,Facts& f,Transition t,std::uint32_t status=0){
+    if(!api.journal(p,f,t,status)){f.journal_ok=false;fail(f,Failure::Journal);return false;}return true;
+}
+template<class API>bool start(API& api,const Plan& p,Facts& f){
+    if(f.start_attempted||f.prepared||!valid(p)){fail(f,Failure::Configuration);return false;}
+    if(!time(api,p,f,p.capture_cutoff))return false;
+    Snapshot existing;const auto queried=api.query(p,0,existing);
+    if(queried!=NotFound){fail(f,queried==Success?Failure::Collision:Failure::Readback,queried);return false;}
+    f.prepared=true;
+    if(!api.build_filters(p)){fail(f,Failure::Filters);return false;}
+    f.filters_built=true;
+    if(!note(api,p,f,Transition::Prepared)||!time(api,p,f,p.capture_cutoff)||
+        !note(api,p,f,Transition::StartIntent))return false;
+    f.start_intent=true;f.start_attempted=true;std::uint64_t id=0;
+    f.start_status=api.start_session(p,id);f.start_returned=true;
+    // Preserve side-effect/ownership facts before any subsequent clock or journal check.
+    f.control=id;f.session_owned=f.start_status==Success&&id!=0;
+    if(f.start_status!=Success||!id){f.historical_uncertain=f.start_status!=AlreadyExists;
+        fail(f,f.start_status==AlreadyExists?Failure::Collision:Failure::Start,f.start_status);}
+    (void)note(api,p,f,Transition::StartReturned,f.start_status);
+    if(!f.session_owned||!f.journal_ok||!time(api,p,f,p.capture_cutoff))return false;
+    Snapshot s;const auto read=api.query(p,id,s);
+    f.session_identity_verified=read==Success&&exact(p,s)&&s.control==id;
+    if(!f.session_identity_verified){fail(f,Failure::Readback,read);return false;}
+    if(!note(api,p,f,Transition::Readback)||!time(api,p,f,p.capture_cutoff)||
+        !note(api,p,f,Transition::ConsumerIntent))return false;
+    f.consumer_attempted=true;const auto opened=api.open_consumer(p);f.consumer_opened=api.consumer_opened();
+    if(opened!=Success||!f.consumer_opened||!api.consumer_running()||!api.consumer_clock_verified(p)){
+        fail(f,Failure::Consumer,opened);}
+    (void)note(api,p,f,Transition::ConsumerReturned,opened);
+    if(f.failure!=Failure::None||!time(api,p,f,p.capture_cutoff)||
+        !note(api,p,f,Transition::EnableIntent))return false;
+    f.enable_intent=true;f.enable_attempted=true;
+    f.enable_status=api.enable(p,id);f.enable_returned=true;f.provider_enabled=f.enable_status==Success;
+    if(!f.provider_enabled){f.historical_uncertain=true;fail(f,Failure::Enable,f.enable_status);}
+    (void)note(api,p,f,Transition::EnableReturned,f.enable_status);
+    if(!time(api,p,f,p.capture_cutoff)||!f.provider_enabled||!f.journal_ok||!api.consumer_running())return false;
+    f.ready=true;return true;
+}
+template<class API>bool cleanup(API& api,const Plan& p,Facts& f){
+    if(f.cleanup_attempted)return f.cleanup_verified;f.cleanup_attempted=true;
+    f.ready=false;
+    // Query exact name + GUID immediately before touching a previously owned session.
+    // A control ID is not an OS HANDLE and is never CloseHandle/CloseTrace'd.
+    if(f.session_owned&&!f.control_consumed){
+        if(time(api,p,f,p.final_cutoff)){
+            Snapshot s;const auto q=api.query(p,f.control,s);
+            if(q==NotFound)f.absence_verified=true;
+            else if(q==Success&&same_session(p,s)&&s.control==f.control){
+                if(f.enable_attempted){
+                    (void)note(api,p,f,Transition::DisableIntent);f.disable_attempted=true;
+                    f.disable_status=api.disable(p,f.control);f.disable_returned=true;
+                    if(f.disable_status!=Success){f.historical_uncertain=true;fail(f,Failure::Disable,f.disable_status);}
+                    (void)note(api,p,f,Transition::DisableReturned,f.disable_status);
+                }
+                if(time(api,p,f,p.final_cutoff)){
+                    (void)note(api,p,f,Transition::StopIntent);f.stop_attempted=true;
+                    const auto owned=f.control;f.control=0;f.control_consumed=true;
+                    f.stop_status=api.stop(p,owned);f.stop_returned=true;
+                    if(f.stop_status!=Success&&f.stop_status!=MoreData&&f.stop_status!=NotFound&&f.stop_status!=ActiveConnections){
+                        f.historical_uncertain=true;fail(f,Failure::Stop,f.stop_status);}
+                    (void)note(api,p,f,Transition::StopReturned,f.stop_status);
+                }
+            }else {f.historical_uncertain=true;fail(f,Failure::Readback,q);}
+        }
+    }
+    if(f.start_attempted){
+        // Never retry Stop through a consumed ID. Polling is read-only and bounded.
+        while(time(api,p,f,p.drain_cutoff)){
+            Snapshot s;const auto q=api.query(p,0,s);
+            if(q==NotFound){f.absence_verified=true;(void)note(api,p,f,Transition::Absence);break;}
+            if(q!=Success||!same_session(p,s)){f.historical_uncertain=true;fail(f,Failure::Absence,q);break;}
+            if(!f.stop_attempted)break;
+            api.pause(10);
+        }
+        if(!f.absence_verified){fail(f,Failure::Absence);f.recovery_required=true;}
+    } // No mutation is distinct from querying an unrelated same-name session absent.
+    if(f.consumer_attempted){
+        if(!f.consumer_opened)f.consumer_close_confirmed=true;
+        f.drained=api.drain(p,p.drain_cutoff);
+        if(f.consumer_opened&&!f.consumer_close_attempted){
+            (void)note(api,p,f,Transition::ConsumerCloseIntent);f.consumer_close_attempted=true;
+            f.close_status=api.close_consumer();
+            f.consumer_close_confirmed=f.close_status==Success||f.close_status==ClosePending;
+            if(!f.consumer_close_confirmed){f.historical_uncertain=true;fail(f,Failure::Close,f.close_status);}
+            (void)note(api,p,f,Transition::ConsumerCloseReturned,f.close_status);
+        }
+        if(!f.drained)f.drained=api.drain(p,p.final_cutoff);
+        if(!f.drained){fail(f,Failure::Drain);f.recovery_required=true;}
+        else (void)note(api,p,f,Transition::Drained);
+    }else{f.drained=true;f.consumer_close_confirmed=true;}
+    f.filters_freed=api.release_filters_and_thread();
+    if(!f.filters_freed){fail(f,Failure::Free);f.recovery_required=true;}
+    else (void)note(api,p,f,Transition::Freed);
+    f.cleanup_verified=(!f.start_attempted||f.absence_verified)&&f.consumer_close_confirmed&&f.drained&&f.filters_freed&&
+        f.journal_ok&&!f.historical_uncertain;
+    f.recovery_required=f.recovery_required||!f.cleanup_verified;
+    return f.cleanup_verified;
+}
+struct RecoveryEvidence{
+    bool journal_chain_verified=false,source_config_artifact_verified=false,component_lock_owned=false;
+    bool original_owner_held_exit_confirmed=false,original_call_worker_held_exit_confirmed=false;
+    bool durable_start_intent=false,original_spawn_unknown=false,unknown_late_call=false;
+    Id session{};Sha config{},source{};
+};
+struct RecoveryBudget{std::uint64_t frequency=0,start=0,deadline=0;};
+inline bool valid(const RecoveryBudget& b){return b.frequency&&b.frequency<=1000000000ULL&&b.start<b.deadline&&
+    b.deadline-b.start<=120*b.frequency;}
+inline bool recovery_admissible(const Plan& p,const RecoveryEvidence& e,const RecoveryBudget& b){
+    return valid(p)&&valid(b)&&e.journal_chain_verified&&e.source_config_artifact_verified&&e.component_lock_owned&&
+        e.original_owner_held_exit_confirmed&&e.original_call_worker_held_exit_confirmed&&e.durable_start_intent&&
+        !e.original_spawn_unknown&&!e.unknown_late_call&&e.session==p.session&&e.config==p.config&&e.source==p.source;
+}
+struct RecoveryFacts{
+    bool admitted=false,absent_before=false,exact_present=false,disable_attempted=false,stop_attempted=false;
+    bool control_consumed=false,absence_verified=false,completed=false,historical_original_uncertainty_preserved=true,journal_ok=true;
+    std::uint32_t query_status=0,disable_status=0,stop_status=0;std::uint64_t last_qpc=0;
+};
+template<class API>bool recover(API& api,const Plan& original,const RecoveryEvidence& e,const RecoveryBudget& b,RecoveryFacts& f){
+    if(f.admitted||!recovery_admissible(original,e,b))return false;
+    auto within=[&](){std::uint64_t now=0;if(!api.now(now)||now<f.last_qpc||now<b.start||now>=b.deadline)return false;
+        f.last_qpc=now;return true;};
+    if(!within())return false;f.admitted=true;
+    Snapshot s;f.query_status=api.query(original,0,s);
+    if(f.query_status==NotFound){f.absent_before=true;f.absence_verified=true;f.completed=true;return true;}
+    if(f.query_status!=Success||!exact(original,s))return false;
+    f.exact_present=true;
+    // Re-query by the freshly observed control ID, not a historical numeric ID.
+    Snapshot checked;if(!within()||api.query(original,s.control,checked)!=Success||
+        !exact(original,checked)||checked.control!=s.control)return false;
+    auto log=[&](Transition t,std::uint32_t status=Success){const bool ok=api.recovery_journal(original,e,b,t,status);f.journal_ok=f.journal_ok&&ok;return ok;};
+    if(!log(Transition::RecoveryAdmitted)||!log(Transition::DisableIntent)||!within())return false;
+    f.disable_attempted=true;f.disable_status=api.disable_recovery(original,s.control,b);
+    (void)log(Transition::DisableReturned,f.disable_status);
+    // Already-owned resource cleanup is still attempted if a later journal write fails.
+    (void)log(Transition::StopIntent);if(!within())return false;
+    f.stop_attempted=true;f.control_consumed=true;f.stop_status=api.stop(original,s.control);
+    (void)log(Transition::StopReturned,f.stop_status);
+    if(f.stop_status!=Success&&f.stop_status!=MoreData&&f.stop_status!=NotFound&&f.stop_status!=ActiveConnections)return false;
+    while(within()){
+        Snapshot after;const auto q=api.query(original,0,after);
+        if(q==NotFound){f.absence_verified=true;break;}
+        if(q!=Success||!exact(original,after))return false;api.pause(10);
+    }
+    (void)log(Transition::Absence);
+    f.completed=f.absence_verified&&f.disable_status==Success&&f.journal_ok;
+    return f.completed;
+}
