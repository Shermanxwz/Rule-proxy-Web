+std::uint32_t WindowsBackend::enable(const Plan& p,std::uint64_t id)noexcept{
+ if(!impl_->filters_built||!impl_->bindings()||!consumer_running())return ERROR_INVALID_STATE;
+ ENABLE_TRACE_PARAMETERS params{};params.Version=ENABLE_TRACE_PARAMETERS_VERSION_2;
+ params.EnableProperty=EVENT_ENABLE_PROPERTY_IGNORE_KEYWORD_0;std::memcpy(&params.SourceId,p.session.data(),16);
