+"""Exact-session recovery adapter; no trace APIs run without a future backend.
+
+All verification is read-only before exact disable/stop. A caller cannot pass
+boolean RecoveryEvidence: journal, source pins and old held generations are
+recomputed. Original uncertainty is never rewritten by current absence.
+"""
+from __future__ import annotations
+import importlib.util
+from pathlib import Path
+spec=importlib.util.spec_from_file_location('etw_recovery_local',Path(__file__).with_name('windows_identity_dns_etw_local.py'))
+local=importlib.util.module_from_spec(spec);spec.loader.exec_module(local)
+c=local.contract
+MODE=0x10000100
+def exact(value,config):
+    keys={'status','session_name','session_guid','control','mode','clock','has_logfile','buffer_kib','minimum_buffers','maximum_buffers'}
+    c.require(type(value) is dict and set(value)==keys and value['status']=='present'
+        and value['session_name']==c.SESSION and value['session_guid']==config['session']['guid']
+        and c.integer(value['control'],1,c.MAX_SIGNED) and value['mode']==MODE and value['clock']==1 and value['has_logfile'] is False
+        and c.integer(value['buffer_kib'],1,64) and c.integer(value['minimum_buffers'],2,1024)
+        and c.integer(value['maximum_buffers'],value['minimum_buffers'],1024)
+        and value['buffer_kib']*value['maximum_buffers']*1024<=c.LIMITS['maximum_memory_bytes'],'etw_recovery_exact')
+    return value
+def budget(value,api):
+    c.require(type(value) is dict and set(value)=={'frequency','start','deadline'} and all(c.integer(v,1,c.MAX_SIGNED) for v in value.values())
+        and value['frequency']==api.qpc_frequency() and value['start']<value['deadline']<=value['start']+30*value['frequency'],'etw_recovery_budget')
+    now=api.qpc();c.require(value['start']<=now<value['deadline'],'etw_recovery_deadline');return now
+def recover(api,config,config_raw,old_records,native_records,recovery_budget,journal_root,*,approved=False):
+    out=dict(schema_version=1,stage='dns-etw-exact-recovery-candidate',completed=False,current_absence_verified=False,
+        historical_original_uncertainty_preserved=True,original_qualification_changed=False,recovery_required=True,failure=None)
+    lock=None;journal=None
+    try:
+        c.require(approved is True and api.runtime_transport_implemented is True,'etw_recovery_optin')
+        c.config(config,local.SOURCES);sha=c.sha(config_raw);c.require(c.decode(config_raw)==config,'etw_recovery_config')
+        c.journal(old_records,config,sha);transitions=c.native_journal(native_records,config,sha)
+        c.require(2 in transitions and any(r['kind']=='start-intent' for r in old_records),'etw_recovery_start_intent')
+        launched=[r for r in old_records if r['kind']=='launch-returned'];c.require(len(launched)==1,'etw_recovery_unknown_spawn')
+        budget(recovery_budget,api);api.verify_source_config_artifact(config,config_raw,None)
+        old=launched[0]['data']
+        c.require(api.original_owner_generation_exited(old['pid'],old['creation_time']) is True
+            and api.original_call_worker_generation_exited(old['pid'],old['creation_time']) is True,'etw_recovery_live_old_call')
+        lock=api.acquire_component_lock(c.SESSION)
+        journal=local.Journal(journal_root,config,sha)
+        journal.append('recovery-verified',dict(old_journal_sha256=c.sha(c.encode(old_records)),original_owner_exited=True,original_call_worker_exited=True))
+        budget(recovery_budget,api);seen=api.query_session(c.SESSION)
