+        else:
+            first=exact(seen,config);budget(recovery_budget,api);second=exact(api.query_control(first['control']),config)
+            c.require(first==second,'etw_recovery_replaced_session')
+            journal.append('recovery-stop-intent',dict(fresh_control_verified=True));budget(recovery_budget,api)
+            # No Start/Enable operation exists in this adapter.
+            disable=api.disable_exact(config,second['control'],recovery_budget)
+            budget(recovery_budget,api);control=second['control'];second=None
+            stopped=api.stop_exact(config,control,recovery_budget)
+            c.require(stopped in (0,234,4201,2402),'etw_recovery_stop_status')
+            while True:
+                budget(recovery_budget,api);seen=api.query_session(c.SESSION)
+                if seen=={'status':'absent'}:out['current_absence_verified']=True;break
+                exact(seen,config);api.pause(10)
