+std::uint32_t WindowsBackend::open_consumer(const Plan& p)noexcept{
+ try{
+  if(impl_->consumer||!impl_->bindings())return ERROR_INVALID_STATE;
+  impl_->consumer=std::make_unique<Context>(p);auto& c=*impl_->consumer;
+  if(!duplicate_query(impl_->controller.value,c.controller)||!duplicate_query(impl_->ordinary.value,c.ordinary))return ERROR_ACCESS_DENIED;
