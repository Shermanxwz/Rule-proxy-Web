+class ZeroAccessAPI(access.NativeAPI):
+    def identity(self,token):
+        # A zero TOKEN_GROUPS count needs only its four-byte header. Never
+        # inspect a Groups pointer/entry unless the declared count is nonzero.
+        def token_sid(kind):
+            buf,n=self._information(token,kind);require(n>=C.sizeof(C.c_void_p),'token_sid_length')
+            p=C.cast(buf,C.POINTER(C.c_void_p))[0]
+            return self._sid(p,C.addressof(buf),n) if p else None
+        buf,n=self._information(token,30);require(n>=4,'capability_header_length')
+        count=C.cast(buf,C.POINTER(C.c_uint32))[0];require(count<=64,'capability_count')
+        require(not count or access.TOKEN_GROUPS.Groups.offset+count*C.sizeof(access.SID_AND_ATTRIBUTES)<=n,'capability_buffer')
+        caps=[]
+        if count:
+            entries=C.cast(C.addressof(buf)+access.TOKEN_GROUPS.Groups.offset,C.POINTER(access.SID_AND_ATTRIBUTES))
+            caps=[dict(sid=self._sid(entries[i].Sid,C.addressof(buf),n),attributes=entries[i].Attributes) for i in range(count)]
+        stats,n=self._information(token,10);require(n==C.sizeof(access.TOKEN_STATISTICS),'token_statistics_length')
+        st=C.cast(stats,C.POINTER(access.TOKEN_STATISTICS))[0];kind=self._scalar(token,8)
+        require(kind==st.TokenType and kind in (1,2),'token_statistics_kind')
+        level=self._scalar(token,9) if kind==2 else None;require(level is None or level==st.ImpersonationLevel,'token_statistics_level')
+        il=token_sid(25);is_ac,elevated,ui=(self._scalar(token,k) for k in (29,20,26))
+        require(all(v in (0,1) for v in (is_ac,elevated,ui)) and il is not None,'token_boolean')
+        luid=lambda x:x.LowPart|((x.HighPart&0xffffffff)<<32)
+        return dict(sid=token_sid(1),session_id=self._scalar(token,12),token_type=kind,impersonation_level=level,
+            appcontainer=bool(is_ac),appcontainer_sid=token_sid(31),integrity_rid=int(il.rsplit('-',1)[1]),
+            elevated=bool(elevated),ui_access=bool(ui),capabilities=sorted(caps,key=lambda row:row['sid']),
+            token_id=luid(st.TokenId),authentication_id=luid(st.AuthenticationId))
+
+def capture_zero_primary(api,token,parent,sid,budget,cutoff):
+    budget.require_ms(cutoff);observed=api.identity(token)
+    caps=[dict(sid=s,attributes=a) for s,a in api.groups(token,30,'TokenCapabilities')]
+    require(caps==[] and observed['capability_count']==0 and observed['appcontainer'] is True
+        and observed['appcontainer_sid']==sid and observed['token_type']==1 and observed['integrity_rid']==4096
+        and observed['sid']==parent['sid'] and observed['session_id']==parent['session_id']
+        and observed['elevated'] is False and observed['ui_access'] is False,'zero_held_identity')
+    raw,n=api.native.query(token,10,'TokenStatistics');require(n==C.sizeof(access.TOKEN_STATISTICS),'zero_statistics_length')
+    st=C.cast(raw,C.POINTER(access.TOKEN_STATISTICS))[0];require(st.TokenType==1,'zero_statistics_kind')
+    luid=lambda v:v.LowPart|((v.HighPart&0xffffffff)<<32)
+    result=dict(sid=observed['sid'],session_id=observed['session_id'],token_type=1,impersonation_level=None,
+        appcontainer=True,appcontainer_sid=sid,integrity_rid=4096,elevated=False,ui_access=False,capabilities=[],
+        token_id=luid(st.TokenId),authentication_id=luid(st.AuthenticationId))
+    identity(result,primary=True);budget.require_ms(cutoff);return result
