+"""Independent trusted-actor zero-cap same-SID loopback mechanism.
+
+No class46, PSEC, extra capability, exemption, WFP or global configuration API.
+Only the separate source/plan/device-bound guarded entry may run this owner.
+"""
+from __future__ import annotations
+import ctypes as C
+import importlib.util
+import os
+from pathlib import Path
+import struct
+import subprocess
+
+ROOT=Path(__file__).resolve().parents[1]
+def load(name,file):
+    s=importlib.util.spec_from_file_location(name,Path(__file__).with_name(file));m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
+identity_cell=load('zero_loopback_identity_base','windows_identity_lpac_identity_cell.py')
+base,access=identity_cell.owner,identity_cell.access
+launcher,helpers,live,local=base.launcher,base.helpers,base.live,base.local
+require,sha,encode,decode=base.require,base.sha,base.encode,base.decode
+SCOPE='one-local-zero-cap-same-sid-loopback-v1'
+PROFILE='same-sid-zero-cap-loopback-mechanism-v1'
+MODULE='.github/windows_identity_lpac_loopback.py'
+LOCAL_MODULE='.github/windows_identity_lpac_loopback_local.py'
+ACTOR='windows_identity_lpac_loopback_actor.exe'
+MANIFEST='identity-lpac-loopback-manifest.json'
+ACTUAL_READY=False
+MAX_REPORT=768*1024
+NONCES=('run','front_boot','selected_boot','ordinary_listener_boot','ordinary_client_boot','before_case','selected_case','after_case')
+NATIVE_SOURCES=('.github/native/windows_identity_lpac_loopback_actor.cpp','.github/native/windows_identity_lpac_loopback_contract.hpp')
+SOURCES=tuple(dict.fromkeys((*identity_cell.SOURCES,*NATIVE_SOURCES,MODULE,LOCAL_MODULE)))
+ACCESS_PROFILE='zero-cap-four-descriptor-lpac-v1'
+PIN=access.PIN.copy()
+EXPECTED,LABELS,SDDLS,FAILURES=access.EXPECTED,access.LABELS,access.SDDLS,access.FAILURES
+RESOURCE_KEYS,CALL_KEYS=access.RESOURCE_KEYS,access.CALL_KEYS
+TOKEN_QUERY,TOKEN_DUPLICATE,MAXIMUM_ALLOWED=access.TOKEN_QUERY,access.TOKEN_DUPLICATE,access.MAXIMUM_ALLOWED
+ApiError,_Owned,resources_clean=access.ApiError,access._Owned,access.resources_clean
