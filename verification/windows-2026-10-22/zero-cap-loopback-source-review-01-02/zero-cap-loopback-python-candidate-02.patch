+def config_validate(c,*,source_names=SOURCES):
+    keys={'schema_version','scope','profile',*NONCES,'ports','frequency','start_qpc','root_deadline_qpc','deadline_qpc',
+        'guard_job_name','source_hashes','source_sha256','device_sha256','actor_sha256','manifest_sha256','recovery_plan_sha256'}
+    require(type(c) is dict and set(c)==keys and type(c['schema_version']) is int and c['schema_version']==1
+        and c['scope']==SCOPE and c['profile']==PROFILE,'zero_config')
+    require(all(base.ac.nonce(c[k]) for k in NONCES) and len({c[k] for k in NONCES})==8,'zero_nonces')
+    live.clock_record(c['start_qpc'],c['frequency'],c['root_deadline_qpc'])
+    require(c['root_deadline_qpc']==c['start_qpc']+120*c['frequency'] and c['deadline_qpc']==c['root_deadline_qpc']-5*c['frequency']
+        and c['guard_job_name']=='Local\\RuleProxy.LocalGuard.'+c['run'],'zero_clock')
+    require(type(c['ports']) is dict and set(c['ports'])=={'frontend','ordinary'}
+        and all(live.integer(v,49153,65535) for v in c['ports'].values()) and len(set(c['ports'].values()))==2,'zero_ports')
+    require(type(c['source_hashes']) is dict and set(c['source_hashes'])==set(source_names)
+        and all(base.ac.digest(v) for v in c['source_hashes'].values()) and sha(encode(c['source_hashes']))==c['source_sha256'],'zero_sources')
+    require(all(base.ac.digest(c[k]) for k in keys if k.endswith('_sha256')),'zero_digests');return c
