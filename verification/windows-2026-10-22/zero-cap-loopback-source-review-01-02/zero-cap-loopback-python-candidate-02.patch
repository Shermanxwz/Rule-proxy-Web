+def identity(value,*,primary):
+    identity_shape(value)
+    require(value['appcontainer'] is True and base.ac.ac_profile_sid(value['appcontainer_sid'])
+        and value['token_type']==(1 if primary else 2) and value['impersonation_level']==(None if primary else 1)
+        and value['integrity_rid']==4096 and value['elevated'] is False and value['ui_access'] is False
+        and value['capabilities']==[],'zero_cap_identity')
+    return value
+
+def duplicate_matches(source,duplicate):
+    identity(source,primary=True);identity(duplicate,primary=False)
+    return all(source[k]==duplicate[k] for k in access.IDENTITY_KEYS-{'token_type','impersonation_level','token_id'})
