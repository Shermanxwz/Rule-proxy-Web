+def validate_plan(p,*,device,source,actor,manifest):
+    keys={'schema_version','scope','profile',*NONCES,'ports','device_sha256','source_sha256','actor_sha256','manifest_sha256',*ACKS,'recovery_reference'}
+    require(type(p) is dict and set(p)==keys and type(p['schema_version']) is int and p['schema_version']==1
+        and p['scope']==SCOPE and p['profile']==PROFILE,'zero_plan')
